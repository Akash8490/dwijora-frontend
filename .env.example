# -----------------------------------------------------------------------------
# Viśvasaṃvid — environment variables
# Copy to `.env` (dev) or set at deploy-time (Vercel/Docker/etc.).
# All NEXT_PUBLIC_* values are inlined into the client bundle — do not put
# secrets there. Server-only secrets are the un-prefixed ones below.
# -----------------------------------------------------------------------------

# --- Public (client + server) ------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=Viśvasaṃvid
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (never inlined into the client) -----------------------------
# HTTP Basic Auth credentials that gate the entire /admin console via
# middleware.ts. Leave BOTH unset in production to disable the console
# (middleware returns 503 rather than exposing anything). Set BOTH to
# enable it and require a login for every /admin request.
ADMIN_BASIC_USER=
ADMIN_BASIC_PASS=
