# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design-review presentation package
# Only the source (scripts/, styles.css, package.json, package-lock.json) is
# committed. All generated artefacts are regenerated by the scripts and
# should NOT be checked in.
design-review/node_modules/
design-review/assets/
design-review/*.pdf
design-review/index.html
design-review/print.html
design-review/manifest.json

# Lighthouse reports (regenerated on demand)
perf-report/reports/

# Claude Code local settings — contains machine-specific absolute paths
# and per-user permission allow-lists. Team-shared config, if any, should
# live in a curated file that's added explicitly.
.claude/settings.json
.claude/settings.local.json
.claude/*.log
